    {
      "id": "kySTh1BPZBU8dS94pt9cU",
      "type": "text",
      "x": -1335.258853407071,
      "y": 9644.449738848663,
      "width": 800,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bCy",
      "roundness": null,
      "seed": 170887568,
      "version": 983,
      "versionNonce": 1402697616,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792259428387,
      "created": 1792257181310,
      "link": null,
      "locked": false,
      "text": "FUNC REQ:\n- should go through seed urls and collect text\n- if there are links then it should go deeper upto certain limit\n- be wary of bot detection, respect robots.txt rules on websites\n\nNON FUNC REQ:\n- crawl 100M webpages per day = 1k webpage per sec\n- store large amount of text, assuming 1 webpage has 500kb html text\n100M x 500kb = 50 TB per day. for year around 20 PB/year of storage\n- since async background processing so p95 latency under few seconds\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FUNC REQ:\n- should go through seed urls and collect text\n- if there are links then it should go deeper upto certain limit\n- be wary of bot detection, respect robots.txt rules on websites\n\nNON FUNC REQ:\n- crawl 100M webpages per day = 1k webpage per sec\n- store large amount of text, assuming 1 webpage has 500kb html text\n100M x 500kb = 50 TB per day. for year around 20 PB/year of storage\n- since async background processing so p95 latency under few seconds\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
