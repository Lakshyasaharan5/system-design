    {
      "id": "40lccbcR22ZrFIiaGVd3N",
      "type": "text",
      "x": -704.3148052947608,
      "y": 11942.730388916338,
      "width": 297,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
