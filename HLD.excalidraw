    {
      "id": "2j7HPGRhZmkTHS2hk8HC9",
      "type": "text",
      "x": -351.539478169904,
      "y": 8091.888330218197,
      "width": 800,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bC8",
      "roundness": null,
      "seed": 777466218,
      "version": 71,
      "versionNonce": 402380714,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792174551217,
      "created": 1792174531986,
      "link": null,
      "locked": false,
      "text": "Order API → Primary DB: Atomic inventory update + order creation\ntransaction.\nOrder table: Add idempotencyKey with a uniqueness constraint scoped to\nthe customer.\nApp Server: Warehouse selection and fallback logic.\nRedis: Cache-aside for product browsing only.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Order API → Primary DB: Atomic inventory update + order creation transaction.\nOrder table: Add idempotencyKey with a uniqueness constraint scoped to the customer.\nApp Server: Warehouse selection and fallback logic.\nRedis: Cache-aside for product browsing only.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
