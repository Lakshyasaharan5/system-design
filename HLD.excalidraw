      "isDeleted": false,
      "boundElements": [],
      "updated": 1792353113710,
      "created": 1792352922107,
      "link": null,
      "locked": false,
      "text": "Shared using\nchatId as key\n\neach shard can be indexed\nusing \n\nShard1\nchat1 [messages]\n\nShard2\nchat2 [messages]\n\nSELECT * FROM Message\nWHERE chatId=101\nORDER BY sequenceNumber asc;",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Shared using\nchatId as key\n\neach shard can be indexed\nusing \n\nShard1\nchat1 [messages]\n\nShard2\nchat2 [messages]\n\nSELECT * FROM Message\nWHERE chatId=101\nORDER BY sequenceNumber asc;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
