    {
      "id": "6qe2T2SOqL08_vBg_mqdx",
      "type": "text",
      "x": -1568.9225972020258,
      "y": 4823.816266688437,
      "width": 475.1993408203125,
      "height": 240,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8J",
      "roundness": null,
      "seed": 856953616,
      "version": 619,
      "versionNonce": 1148528978,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791696322143,
      "created": 1791603396871,
      "link": null,
      "locked": false,
      "text": "Requirements:\n\n- should convert long url to short url\n- availability >> consistency \n- should be able to store millions of urls\n- redirection should be <100ms\n- hashing function -> \n\n        /long-urlsdlkfjsldf - /abc123AB  [64bits] 2^64\n\n\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirements:\n\n- should convert long url to short url\n- availability >> consistency \n- should be able to store millions of urls\n- redirection should be <100ms\n- hashing function -> \n\n        /long-urlsdlkfjsldf - /abc123AB  [64bits] 2^64\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "9HnWJj_1Kw3Aenze0OoQW",
      "type": "rectangle",
      "x": -993.2232103186925,
      "y": 4816.245612756089,
      "width": 585.7160257266798,
      "height": 206.542942723564,
      "angle": 0,
