    {
      "id": "lcwQNZGSiQS7I_gVMb8uh",
      "type": "text",
      "x": -923.7205046874308,
      "y": 4816.693265855536,
      "width": 615.9991455078125,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8L",
      "roundness": null,
      "seed": 964139218,
      "version": 448,
      "versionNonce": 1987121742,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791734275566,
      "created": 1791697126400,
      "link": null,
      "locked": false,
      "text": "algorithm\na-z,A-Z,0-9 -> 26+26+10=62 characters so Base62\nBase64 = Base62 with '+''-'\nwe can have db id like 12345 convert to Base62 3d7 but its predictable\nbest: snowflake style \n1bit: sign bit\n41bit: milliseconds since a custom epoch\n10bit : up to 1,024 worker IDs\n20bit: 4,096 IDs per millisecond per worker\n\n\n\n",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "algorithm\na-z,A-Z,0-9 -> 26+26+10=62 characters so Base62\nBase64 = Base62 with '+''-'\nwe can have db id like 12345 convert to Base62 3d7 but its predictable\nbest: snowflake style \n1bit: sign bit\n41bit: milliseconds since a custom epoch\n10bit : up to 1,024 worker IDs\n20bit: 4,096 IDs per millisecond per worker\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
