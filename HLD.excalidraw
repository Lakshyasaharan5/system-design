    {
      "id": "4_-32tjZkiNahdJ-VZUD_",
      "type": "text",
      "x": -1266.2149034179354,
      "y": 11347.565082367091,
      "width": 800,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bEh",
      "roundness": null,
      "seed": 971165072,
      "version": 555,
      "versionNonce": 1534475632,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792276414775,
      "created": 1792276106287,
      "link": null,
      "locked": false,
      "text": "Design a notification system that allows an application to send\nnotifications to users through:\n- Email\n- SMS\n- Push notifications\nFor example, when a user places an order on an e-commerce website, they\nshould receive an order confirmation notification.\n\nFUNC REQ:\n- app should send notification to users via diff channels\n\nNON FUNC REQ:\n- assuming 100M DAU and they are using our website and expect to receive\nnotifications based on different events; 100M/10^5 = 1k notification/sec\nwith peak factor of 5 so let's say 5k notification per second \n- user should receive the notification, can be little delay so strong\navailability > consistency\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Design a notification system that allows an application to send notifications to users through:\n- Email\n- SMS\n- Push notifications\nFor example, when a user places an order on an e-commerce website, they should receive an order confirmation notification.\n\nFUNC REQ:\n- app should send notification to users via diff channels\n\nNON FUNC REQ:\n- assuming 100M DAU and they are using our website and expect to receive notifications based on different events; 100M/10^5 = 1k notification/sec\nwith peak factor of 5 so let's say 5k notification per second \n- user should receive the notification, can be little delay so strong availability > consistency\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
