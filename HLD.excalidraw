      "boundElements": [],
      "updated": 1791603040796,
      "created": 1791602918880,
      "link": null,
      "locked": false,
      "text": "if redis fails -> use redis cluster or fail-open or fail close \n(allow all request)\n\nif rate limiter fails -> user cluster so LB sends to healthy instance\n or allow all or deny all",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if redis fails -> use redis cluster or fail-open or fail close \n(allow all request)\n\nif rate limiter fails -> user cluster so LB sends to healthy instance\n or allow all or deny all",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
